DJANGO_SECRET_KEY=replace-with-a-random-secret-key-at-least-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://hitech-drone-service.duckdns.org
DATABASE_URL=postgresql://app_user:replace-password@db-host:5432/hitech_drone_mapping
DIRECT_URL=postgresql://app_user:replace-password@db-host:5432/hitech_drone_mapping
DATABASE_URL_TEST=postgresql://app_user:replace-password@db-host:5432/hitech_drone_mapping_test
DIRECT_URL_TEST=postgresql://app_user:replace-password@db-host:5432/hitech_drone_mapping_test
HITECH_AUTH_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-hitech-auth-rsa-public-key\n-----END PUBLIC KEY-----
HITECH_AUTH_ACCESS_COOKIE_NAME=hitech_access_token
ENABLE_DEMO_AUTH=False
DEMO_AUTH_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-assessment-demo-private-rsa-key-runtime-secret\n-----END PRIVATE KEY-----
DEMO_AUTH_PRIVATE_KEY_PATH=.demo-auth/private_key.pem
DEMO_AUTH_PUBLIC_KEY_PATH=.demo-auth/public_key.pem
DEMO_AUTH_TOKEN_TTL_SECONDS=900
R2_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=replace-with-private-r2-bucket-name
R2_PUBLIC_URL=
POTREE_CONVERTER_PATH=
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
MAX_FILE_SIZE_BYTES=10737418240
MAX_SURVEY_TOTAL_SIZE_BYTES=53687091200
UPLOAD_CHUNK_SIZE_BYTES=8388608
RATE_LIMIT_UPLOAD=10/m
RATE_LIMIT_RETRY=5/m
